# ==============================================================================
# GUSAC SECURE BACKEND — GOOGLE CLOUD PLATFORM (GCP) ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local testing or inject into Google Secret Manager.

# 1. SERVER & CLOUD RUN SETTINGS
NODE_ENV=production
PORT=8080
# Comma-separated list of allowed origins (e.g. your custom domain & local dev)
CORS_ORIGIN=https://gusac.gitam.edu,https://gusac-visakhapatnam.web.app,http://localhost:3000

# 2. CRYPTOGRAPHIC SECRETS (Store in Google Secret Manager in Production)
# Generate high-entropy 64-character random strings:
# e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_super_secret_session_encryption_key_min_32_chars
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_chars
HMAC_PASS_SECRET=your_cryptographic_hmac_qr_pass_signing_secret_key

# 3. DATABASE (Cloud SQL PostgreSQL or Firestore)
DB_TYPE=postgres
DATABASE_URL=postgresql://gusac_admin:StrongPasswordHere@/gusac_db?host=/cloudsql/your-project-id:asia-south1:gusac-postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gusac_db
DB_USER=gusac_admin
DB_PASSWORD=your_secure_cloud_sql_password

# 4. GOOGLE CLOUD PLATFORM CONFIGURATION
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCS_MEDIA_BUCKET=gusac-visakhapatnam-media-assets
GCS_PASS_STORAGE_BUCKET=gusac-encrypted-passes

# 5. EMAIL & OTP NOTIFICATION SERVICE (SendGrid / Gmail API / SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_workspace_smtp_api_key
EMAIL_FROM_ADDRESS=gusac@gitam.edu
EMAIL_FROM_NAME="GUSAC Visakhapatnam Main Campus"

# 6. ADMIN INITIAL BOOTSTRAP (For first-time Cloud SQL migration)
BOOTSTRAP_ADMIN_EMAIL=admin@gitam.in
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisPasswordImmediately123!
